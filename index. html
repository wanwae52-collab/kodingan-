<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Volleyball Team</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #f1f7ff;
    color: #222;
}

nav {
    background: #1565c0;
    color: white;
    padding: 18px 25px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 100;
}

nav h2 {
    font-size: 21px;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 18px;
    font-size: 14px;
}

nav a:hover {
    text-decoration: underline;
}

.hero {
    background: linear-gradient(135deg, #0d47a1, #1976d2, #42a5f5);
    color: white;
    text-align: center;
    padding: 75px 20px;
}

.hero .bola {
    font-size: 65px;
    margin-bottom: 15px;
}

.hero h1 {
    font-size: 40px;
    margin-bottom: 10px;
}

.hero p {
    font-size: 17px;
    margin: 6px;
}

.container {
    max-width: 1050px;
    margin: auto;
    padding: 40px 20px;
}

.title {
    text-align: center;
    margin-bottom: 25px;
}

.title h2 {
    color: #1565c0;
    font-size: 28px;
}

.title p {
    color: #777;
    margin-top: 8px;
}

/* STATISTIK */
.stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-bottom: 40px;
}

.stat {
    background: white;
    text-align: center;
    padding: 25px 10px;
    border-radius: 15px;
    box-shadow: 0 5px 18px rgba(21,101,192,0.12);
}

.stat .icon {
    font-size: 32px;
}

.stat h3 {
    color: #1565c0;
    font-size: 30px;
    margin: 8px 0;
}

.stat p {
    color: #777;
}

/* CARD */
.card {
    background: white;
    padding: 28px;
    border-radius: 15px;
    margin-bottom: 25px;
    box-shadow: 0 5px 18px rgba(21,101,192,0.10);
}

.card h2 {
    color: #1565c0;
    margin-bottom: 20px;
}

/* PEMAIN */
.players {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
}

.player {
    background: #e3f2fd;
    padding: 20px;
    border-radius: 12px;
    text-align: center;
    border-bottom: 4px solid #1976d2;
    transition: 0.3s;
}

.player:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 18px rgba(21,101,192,0.15);
}

.player .avatar {
    font-size: 40px;
    margin-bottom: 10px;
}

.player h3 {
    color: #1565c0;
    margin-bottom: 5px;
}

/* JADWAL */
.schedule {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
}

.schedule-item {
    background: #e3f2fd;
    padding: 18px;
    border-radius: 10px;
    border-left: 5px solid #1976d2;
}

.schedule-item h4 {
    color: #1565c0;
    margin-bottom: 7px;
}

/* PRESTASI */
.achievement {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
}

.achievement-box {
    background: #f5faff;
    border: 2px solid #bbdefb;
    padding: 22px;
    border-radius: 12px;
    text-align: center;
}

.achievement-box .medal {
    font-size: 40px;
}

.achievement-box h3 {
    color: #1565c0;
    margin: 10px 0;
}

/* =========================
   GALERI
========================= */

.gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
}

.gallery-item {
    background: #e3f2fd;
    border-radius: 15px;
    overflow: hidden;
    text-align: center;
    box-shadow: 0 5px 18px rgba(21,101,192,0.12);
    transition: 0.3s;
}

.gallery-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(21,101,192,0.20);
}

.gallery-item img {
    width: 100%;
    height: 350px;
    object-fit: cover;
    display: block;
}

.gallery-item p {
    padding: 15px;
    color: #1565c0;
    font-weight: bold;
}

/* QUOTE */
.quote {
    background: linear-gradient(135deg, #1565c0, #42a5f5);
    color: white;
    text-align: center;
    padding: 35px 20px;
    border-radius: 15px;
    margin-bottom: 25px;
}

.quote p {
    font-size: 20px;
    font-style: italic;
}

.quote span {
    display: block;
    margin-top: 10px;
}

/* FOOTER */
footer {
    background: #0d47a1;
    color: white;
    text-align: center;
    padding: 30px 20px;
}

footer h3 {
    margin-bottom: 8px;
}

/* MOBILE */
@media (max-width: 750px) {

    nav {
        flex-direction: column;
        gap: 12px;
    }

    nav a {
        margin: 5px;
    }

    .hero h1 {
        font-size: 30px;
    }

    .stats {
        grid-template-columns: repeat(2, 1fr);
    }

    .players {
        grid-template-columns: 1fr;
    }

    .schedule {
        grid-template-columns: 1fr;
    }

    .achievement {
        grid-template-columns: 1fr;
    }

    .gallery {
        grid-template-columns: 1fr;
    }

    .gallery-item img {
        height: 300px;
    }
}
</style>
</head>

